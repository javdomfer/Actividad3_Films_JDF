<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pelicula.Title %> - Google</title>
  <base href="/">
  <link rel="stylesheet" href="app.css" class="css">
</head>
<body>
  <header class="top">
    <a href="/" class="logo-small">
      <span class="b">G</span><span class="r">o</span><span class="y">o</span><span class="b">g</span><span class="g">l</span><span class="r">e</span>
    </a>
    <form action="/search" method="GET" class="search-form-small">
      <input type="text" name="q" value="<%= query %>">
      <button type="submit">Buscar</button>
    </form>
  </header>

  <main class="results">
    <article class="result">
      <h2><%= pelicula.Title %></h2>
      <p class="year">Año: <%= pelicula.Year %></p>
      <p class="plot"><%= pelicula.Plot %></p>
    </article>

    <section class="images">
      <% pelicula.Images.forEach((img) => { %>
        <img src="<%= img %>" alt="<%= pelicula.Title %>">
      <% }) %>
    </section>
  </main>
</body>
</html>
